<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Verification tool for the LintMark formatter. It formats Markdown corpora in memory (never writing to them)
    and checks that the formatted text renders to the same HTML, keeps the Pandoc structure and is stable when
    formatted again. It is a developer tool: it is not packed and the product does not reference it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- A single target keeps "dotnet run" with the project path free of a framework argument;
         RollForward lets the tool run on newer runtimes. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DemaConsulting.LintMark.Verify</AssemblyName>
    <RootNamespace>DemaConsulting.LintMark.Verify</RootNamespace>

    <IsPackable>false</IsPackable>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References: the product's internals are reachable through its InternalsVisibleTo. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.LintMark\DemaConsulting.LintMark.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemaConsulting.LintMark.Tests" />
    <InternalsVisibleTo Include="DemaConsulting.LintMark.Verify.Tests" />
  </ItemGroup>

</Project>
